{
  "name": "darkroom-ui",
  "version": "0.2.3",
  "description": "Monochrome editorial React component library with CSS-variable light/dark theming",
  "type": "module",
  "license": "MIT",
  "author": "laradiaz (https://www.npmjs.com/~laradiaz)",
  "homepage": "https://darkroom-ui.dev",
  "bugs": "https://github.com/laradiaz/darkroom-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laradiaz/darkroom-ui.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "main": "./lib/darkroom-ui.cjs",
  "module": "./lib/darkroom-ui.mjs",
  "types": "./lib/darkroom-ui.d.ts",
  "style": "./lib/style.css",
  "exports": {
    ".": {
      "types": "./lib/darkroom-ui.d.ts",
      "import": "./lib/darkroom-ui.mjs",
      "require": "./lib/darkroom-ui.cjs",
      "default": "./lib/darkroom-ui.mjs"
    },
    "./core": {
      "types": "./lib/core.d.ts",
      "import": "./lib/core.mjs",
      "require": "./lib/core.cjs"
    },
    "./button": {
      "types": "./lib/button.d.ts",
      "import": "./lib/button.mjs",
      "require": "./lib/button.cjs"
    },
    "./select": {
      "types": "./lib/select.d.ts",
      "import": "./lib/select.mjs",
      "require": "./lib/select.cjs"
    },
    "./file-dropzone": {
      "types": "./lib/file-dropzone.d.ts",
      "import": "./lib/file-dropzone.mjs",
      "require": "./lib/file-dropzone.cjs"
    },
    "./badge": {
      "types": "./lib/badge.d.ts",
      "import": "./lib/badge.mjs",
      "require": "./lib/badge.cjs"
    },
    "./typography": {
      "types": "./lib/typography.d.ts",
      "import": "./lib/typography.mjs",
      "require": "./lib/typography.cjs"
    },
    "./layout": {
      "types": "./lib/layout.d.ts",
      "import": "./lib/layout.mjs",
      "require": "./lib/layout.cjs"
    },
    "./grid": {
      "types": "./lib/grid.d.ts",
      "import": "./lib/grid.mjs",
      "require": "./lib/grid.cjs"
    },
    "./divider": {
      "types": "./lib/divider.d.ts",
      "import": "./lib/divider.mjs",
      "require": "./lib/divider.cjs"
    },
    "./media": {
      "types": "./lib/media.d.ts",
      "import": "./lib/media.mjs",
      "require": "./lib/media.cjs"
    },
    "./card": {
      "types": "./lib/card.d.ts",
      "import": "./lib/card.mjs",
      "require": "./lib/card.cjs"
    },
    "./hero": {
      "types": "./lib/hero.d.ts",
      "import": "./lib/hero.mjs",
      "require": "./lib/hero.cjs"
    },
    "./navigation": {
      "types": "./lib/navigation.d.ts",
      "import": "./lib/navigation.mjs",
      "require": "./lib/navigation.cjs"
    },
    "./footer": {
      "types": "./lib/footer.d.ts",
      "import": "./lib/footer.mjs",
      "require": "./lib/footer.cjs"
    },
    "./style.css": "./lib/style.css",
    "./fonts.css": "./lib/fonts.css",
    "./tokens.css": "./lib/tokens.css"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && cp src/theme/tokens.css lib/tokens.css && node scripts/build-fonts.mjs",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STORYBOOK=true storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-publish": "bash scripts/check-publish.sh",
    "check-publish:full": "DARKROOM_UI_CHECK_STORYBOOK=1 bash scripts/check-publish.sh",
    "prepublishOnly": "pnpm run build && pnpm run check-publish && pnpm test"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "react-dom": ">=16.8"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.2.5",
    "@fontsource/dm-sans": "^5.2.5",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "monochrome",
    "dark-mode"
  ]
}
